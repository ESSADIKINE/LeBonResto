# LeBonResto marketing site — environment variables
# Copy this file to `.env.local` (dev) or set these in your hosting provider (prod).
# All lead form routes (/api/leads/investor, /api/leads/restaurant, /api/leads/contact)
# best-effort forward validated payloads to LEADS_WEBHOOK_URL. If forwarding fails,
# the user still gets a 200 response and the failure is logged with the prefix
# [LeadWebhookError] so ops can replay from server logs.

# Server-only. Slack incoming webhook, Zapier catch hook, or n8n endpoint.
# Leave empty in dev to skip forwarding (payloads are still console.logged).
LEADS_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL_or_zapier

# Server-only. Brevo (Sendinblue) v3 transactional API key.
# Get one from Brevo → Settings → SMTP & API → API Keys → v3.
# Without this the lead routes still return ok, but no email is sent.
BREVO_API_KEY=

# Server-only. Verified sender identity on Brevo (Senders → Add).
# Default is le.bon.restau@gmail.com — must be validated on Brevo first.
BREVO_SENDER_EMAIL=le.bon.restau@gmail.com

# Server-only. Display name that recipients see.
BREVO_SENDER_NAME=Le Bon Resto

# Server-only. Internal recipient for lead notifications.
# Set replyTo on outbound so hitting Reply lands directly on the lead's email.
LEADS_EMAIL_TO=anass.essadikine2@gmail.com

# Client-exposed. Plausible domain identifier read by components/analytics/Analytics.tsx.
# Leave empty to skip loading Plausible (e.g. in Preview).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Client-exposed. Microsoft Clarity project ID for session replay + heatmaps.
NEXT_PUBLIC_CLARITY_ID=

# Reserved for future use — canonical URL is currently hardcoded to https://lebonresto.ma
# in app/layout.tsx, app/sitemap.ts, app/robots.ts. Set once we consume it.
NEXT_PUBLIC_SITE_URL=https://business.lebonresto.ma
